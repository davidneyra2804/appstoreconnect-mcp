# App Store Connect MCP - example configuration
#
# Copy to .env and fill in real values, or export these variables directly.
# Never commit a filled-in copy: .env and *.p8 are already ignored by git.

# Key ID of the App Store Connect API key (the .p8 file identifier).
APPLE_KEY_ID=

# Issuer ID (Apple team ID) that owns the apps.
APPLE_ISSUER_ID=

# Either APPLE_PRIVATE_KEY (PEM content, raw or base64)
APPLE_PRIVATE_KEY=

# ...or APPLE_PRIVATE_KEY_PATH (path to the downloaded .p8 file).
# APPLE_PRIVATE_KEY_PATH=

# Optional scope: restrict the server to a single app.
# APPLE_BUNDLE_ID=com.example.myapp
# App Store Connect app id (the "id" of the apps resource, the value the tools
# take as appId):
# APPLE_APP_ID=1234567890
# Customer-facing App Store ID (the "sku" attribute of the apps resource):
# APPLE_APP_STORE_SKU=123456789
#
# APPLE_APP_STORE_ID is not accepted: it was ambiguous between the two above.

# Optional log level: debug, info, warn, error. Defaults to info.
# LOG_LEVEL=info
